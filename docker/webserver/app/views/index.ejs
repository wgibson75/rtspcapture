<html>
  <head>
    <link href="/css/index.css" rel="stylesheet" />
    <script type="text/javascript">

    function gotoUrl(url) {
      top.document.location = url;
    }

    function submit(action) {
      var form = document.getElementById("auth_form");
      form.action = action;
      form.submit();
    }

    </script>
  </head>
  <body>
    <div class="recordings_status">Recordings:
      <b class="recordings_status_bold"><%= total_record_time %> days</b>
    </div>
    <form id="auth_form" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    </form>

    <table class="auth" border="0">
      <tr class="auth">
        <td><div class="cell-content" onclick="submit('/logout')">LOGOUT</div></td>
        <td><div class="cell-content" onclick="gotoUrl('/signup')">SIGNUP</div></td>
        <td><div class="cell-content" onclick="gotoUrl('/accounts')">ACCOUNTS</div></td>
      </tr>
    </table>

    <table border="0">
      <tr>
        <td><div class="cell-content" onclick="gotoUrl('/console')">Console</div></td>
        <td><div class="cell-content" onclick="gotoUrl('/snapshots')">Snapshots</div></td>
      </tr>
      <tr>
        <td><div class="cell-content" onclick="gotoUrl('/capture')">Recordings</div></td>
        <td><div class="cell-content" onclick="gotoUrl('/logs')">Logs</div></td>
      </tr>
    </table>
  </body>
</html>
